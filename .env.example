# =============================================================================
# ADOFAI.VERSE — combined reference OR copy everything into `.env.local` for local dev only.
# Split for sharing: `.env.public.example` → `.env`, `.env.local.example` → `.env.local`
# Developer docs: https://dev.adofai.net (OAuth IdP) → /dev/environment
# Repo: https://github.com/3289david/adofai-verse
# =============================================================================

# PostgreSQL — share with IdP if OAuth user.id must match
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/adofai_community"

# Site JWT (auth_token cookie) — independent from IdP JWT_SECRET unless you intentionally sync
JWT_SECRET=""

# Public site origin (OAuth redirect base must be https://THIS_HOST/api/auth/oauth/callback)
NEXT_PUBLIC_APP_URL="https://adofai.net"

# -----------------------------------------------------------------------------
# Central OAuth / IdP
# -----------------------------------------------------------------------------
NEXT_PUBLIC_AUTH_ISSUER="https://auth.adofai.net"
OAUTH_ISSUER="https://auth.adofai.net"
OAUTH_CLIENT_ID="adofai_verse_web"

# -----------------------------------------------------------------------------
# Email — Resend (site-specific flows: resend verification if still exposed, etc.)
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM="ADOFAI.NET <onboarding@resend.dev>"

# -----------------------------------------------------------------------------
# Cloudflare Turnstile — any remaining server-side protected forms
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# -----------------------------------------------------------------------------
# Steam Workshop import (optional)
# -----------------------------------------------------------------------------
STEAM_API_KEY=""

# -----------------------------------------------------------------------------
# Optional AI / misc
# -----------------------------------------------------------------------------
# POLLINATIONS_SEED="42"
