# PostgreSQL connection string for your VPS
DATABASE_URL="postgresql://user:password@localhost:5432/adofai_verse"

# JWT secret — run: openssl rand -base64 32
JWT_SECRET="9e9a6610ba2baaf4893da97ca07545e8413d3ca4183dfce832b8de7263717e32"

# App URL (this site — used as OAuth redirect base)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Central identity provider (authorization server — deploy adofai-auth repo here)
NEXT_PUBLIC_AUTH_ISSUER="https://auth.adofai.net"
# Server-side duplicate (optional, for API routes during SSR)
OAUTH_ISSUER="https://auth.adofai.net"

# OAuth client id registered on the IdP — seed default `adofai_verse_web`
OAUTH_CLIENT_ID="adofai_verse_web"

# Optional: Pollinations AI uses no API key (free)
# POLLINATIONS_SEED="42"
